# Codex 앱 기본 설정 — 폐쇄망 Windows
# 설치: %USERPROFILE%\.codex\config.toml 로 복사한 뒤 모델 이름과 경로를 맞춘다.
# 기존 config.toml 이 있으면 [projects.*] 와 플러그인 절은 남기고 아래 키만 옮긴다.
# 키 이름은 Codex 설정 레퍼런스(learn.chatgpt.com/docs/config-file/config-reference) 기준, 2026-10-28.

# ── 모델 ─────────────────────────────────────────────────────────────
model = "gpt-6-luna"               # 일상 구현·질의·worker. 리뷰는 gpt-6.1-sol(review 프로필)
model_reasoning_effort = "medium"  # low | medium | high | xhigh (모델·클라이언트에 따라 다름)
# model_context_window = 272000    # 모델이 알려 주지 않을 때만 지정
# model_auto_compact_token_limit = 200000   # 자동 /compact 임계. 미지정이면 모델 기본

# ── 승인·샌드박스 ────────────────────────────────────────────────────
approval_policy = "on-request"     # 샌드박스 밖 명령은 rules/default.rules 가 allow|prompt|forbidden 결정
sandbox_mode = "workspace-write"   # 저장소 안만 쓰기. 읽기 전용 작업은 qa 프로필
# windows.sandbox = "unelevated"   # 사내 PC 정책에 맞게. mxc 가 막혀 있으면 elevated|unelevated

# ── 지침·스킬 ────────────────────────────────────────────────────────
project_doc_max_bytes = 65536      # 전역 AGENTS.md + 저장소 AGENTS.md 합산 상한(기본 32 KiB → 64 KiB)
project_doc_fallback_filenames = ["TEAM_GUIDE.md"]

[skills]
max_context_tokens = 10000         # 스킬 목록 예산 최대값(기본은 컨텍스트의 2%)

# 특정 스킬을 파일은 두고 끄기
# [[skills.config]]
# path = "C:/git/codex-skills/.agents/skills/html-to-pdf/SKILL.md"
# enabled = false

# ── 서브에이전트(앱 안 오케스트레이션) ───────────────────────────────
[agents]
enabled = true
max_concurrent_threads_per_session = 2         # 편집 1 + 읽기 전용 1 (전역 규칙 7a)
default_subagent_model = "gpt-6-luna"       # worker·explorer. reviewer 는 agents/reviewer.toml 에서 sol
default_subagent_reasoning_effort = "medium"
# 역할별 설정은 agents/*.toml 파일로 둔다(codex-home/agents/). Windows 에서 이름 있는 에이전트의
# TOML 값이 적용되지 않는다는 보고(openai/codex#19399)가 있으니 spawn 요청에 model·effort 를 직접 적는다.

# ── 표시 ─────────────────────────────────────────────────────────────
hide_agent_reasoning = false

[tui]
notifications = true               # 긴 작업이 끝나면 알림
notification_condition = "unfocused"

# ── 프로필(같은 폴더의 <이름>.config.toml 을 --profile <이름> 으로 겹쳐 씀) ──
# review.config.toml : 리뷰 전용, gpt-6.1-sol, effort high, read-only
# qa.config.toml     : 질의응답·탐색, gpt-6-luna, effort low, read-only

# ── 사용량 표시(hooks.json + scripts/codex_usage.py) ──────────────────
# hooks 는 기본으로 켜져 있다. 새 hook 은 Codex 에서 /hooks 로 한 번 신뢰해야 돈다.
# 예산(사내 기준 3000)·단위·기간은 scripts/codex_usage.py 맨 위 BUDGET_UNITS / TOKENS_PER_UNIT / BUDGET_PERIOD 에서 바꾼다.

# Codex 실행 정책 — 폐쇄망 Windows (Git Bash / PowerShell)
# 설치: %USERPROFILE%\.codex\rules\default.rules
# 문법: prefix_rule(pattern=[토큰...], decision="allow|prompt|forbidden", justification="...")
# 여러 규칙이 맞으면 가장 엄격한 쪽이 이긴다(forbidden > prompt > allow).
# 점검: codex execpolicy check -- git status
# 주의: 리다이렉트(>)나 $( ) 가 있는 명령은 통째로 비교되므로 안쪽 명령 규칙이 안 걸린다.

# ── 읽기 전용: 묻지 않고 실행 ─────────────────────────────────────────
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "blame"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["dir"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["python", "--version"], decision="allow")
prefix_rule(pattern=["python", "-c"], decision="prompt", justification="임의 코드 실행이라 한 번 확인")

# ── 테스트·검증: 묻지 않고 실행 ───────────────────────────────────────
prefix_rule(pattern=["python", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["python", "-I", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["python", "-m", "ruff"], decision="allow")
prefix_rule(pattern=["ruff"], decision="allow")
prefix_rule(pattern=["python", "-m", "mypy"], decision="allow")
prefix_rule(pattern=["python", "-m", "compileall"], decision="allow")
prefix_rule(pattern=[".venv-skills/Scripts/python.exe"], decision="allow")
prefix_rule(pattern=[".venv-skills\\Scripts\\python.exe"], decision="allow")
# python scripts/x.py 같은 저장소 스크립트는 규칙 없음 → approval_policy(on-request)대로 묻는다.
# 토큰 단위 비교라 "scripts/" 접두사로는 잡히지 않는다. 자주 쓰는 스크립트는 전체 경로로 allow 를 추가한다.

# ── 쓰기 계열 git: 한 번 확인 ────────────────────────────────────────
prefix_rule(pattern=["git", "add"], decision="prompt")
prefix_rule(pattern=["git", "commit"], decision="prompt", justification="전역 규칙 7절: 커밋은 사용자가 요청할 때만")
prefix_rule(pattern=["git", "switch"], decision="prompt")
prefix_rule(pattern=["git", "checkout", "-b"], decision="prompt")
prefix_rule(pattern=["git", "stash", "push"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt")
prefix_rule(pattern=["pip", "install"], decision="prompt", justification="전역 규칙 7절: 의존성 추가는 승인 뒤")
prefix_rule(pattern=["python", "-m", "pip", "install"], decision="prompt", justification="전역 규칙 7절: 의존성 추가는 승인 뒤")

# ── 파괴적·복구 수단 금지 ────────────────────────────────────────────
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden", justification="전역 규칙 7절. 되돌리려면 변경을 기록하고 사용자에게 묻는다")
prefix_rule(pattern=["git", "checkout", "--"], decision="forbidden", justification="전역 규칙 7절. 파일 단위 복원도 사용자 확인 뒤")
prefix_rule(pattern=["git", "checkout", "."], decision="forbidden", justification="전역 규칙 7절")
prefix_rule(pattern=["git", "restore"], decision="forbidden", justification="전역 규칙 7절. 사용자 확인 뒤")
prefix_rule(pattern=["git", "clean"], decision="forbidden", justification="전역 규칙 7절")
prefix_rule(pattern=["git", "stash", "pop"], decision="forbidden", justification="전역 규칙 7절. stash 는 사용자가 푼다")
prefix_rule(pattern=["git", "stash", "drop"], decision="forbidden", justification="전역 규칙 7절")
prefix_rule(pattern=["git", "push"], decision="forbidden", justification="전역 규칙 7절: push 는 사용자가 직접")
prefix_rule(pattern=["git", "merge"], decision="forbidden", justification="병합은 사용자가 직접")
prefix_rule(pattern=["git", "rebase"], decision="forbidden", justification="사용자가 직접")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden", justification="전역 규칙 7절")
prefix_rule(pattern=["git", "worktree", "remove"], decision="forbidden", justification="전역 규칙 7절")
prefix_rule(pattern=["rm", "-rf"], decision="forbidden", justification="삭제는 사용자가 직접. 임시 파일은 tmp/ 안에서만")
prefix_rule(pattern=["rm", "-r"], decision="forbidden", justification="삭제는 사용자가 직접")
prefix_rule(pattern=["Remove-Item", "-Recurse"], decision="forbidden", justification="삭제는 사용자가 직접")
prefix_rule(pattern=["rmdir", "/s"], decision="forbidden", justification="삭제는 사용자가 직접")
prefix_rule(pattern=["del", "/s"], decision="forbidden", justification="삭제는 사용자가 직접")
prefix_rule(pattern=["sed", "-i"], decision="forbidden", justification="전역 규칙 7b: 파일 수정은 apply_patch")
prefix_rule(pattern=["npm", "install"], decision="forbidden", justification="폐쇄망: npm 없음")
prefix_rule(pattern=["npx"], decision="forbidden", justification="폐쇄망: npm 없음")
prefix_rule(pattern=["curl"], decision="forbidden", justification="폐쇄망: 외부망 없음")
prefix_rule(pattern=["wget"], decision="forbidden", justification="폐쇄망: 외부망 없음")
prefix_rule(pattern=["Invoke-WebRequest"], decision="forbidden", justification="폐쇄망: 외부망 없음")

{
  "description": "턴마다 토큰 사용량을 보여 준다. 설치: %USERPROFILE%\\.codex\\hooks.json, 스크립트는 %USERPROFILE%\\.codex\\scripts\\codex_usage.py. 경로의 <계정> 을 바꾼 뒤 Codex 에서 /hooks 로 신뢰(trust) 한다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/scripts/codex_usage.py\" --hook",
            "commandWindows": "python C:/Users/<계정>/.codex/scripts/codex_usage.py --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/scripts/codex_usage.py\" --hook",
            "commandWindows": "python C:/Users/<계정>/.codex/scripts/codex_usage.py --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
